    "build": "npm --prefix frontend run build",
    "test": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:browser": "node scripts/run-tests.mjs browser-phase2c",
    "test:browser:product-shell": "node scripts/run-tests.mjs browser-product-shell",
    "test:browser:phase2a": "node scripts/run-tests.mjs browser-phase2a",
    "test:browser:phase2b": "node scripts/run-tests.mjs browser-phase2b",
    "test:browser:phase2c": "node scripts/run-tests.mjs browser-phase2c",
    "test:milestone1": "node scripts/run-tests.mjs m1-regression",
    "test:control-plane": "npm run test:control-plane:node && npm run test:control-plane:py",
    "test:control-plane:node": "node --test \"tools/control-plane-qa/tests/*.test.mjs\"",
    "test:control-plane:py": "python -m unittest discover -s backend/tests/control_plane -p \"test_*.py\"",
    "test:control-plane:db": "python -m unittest discover -s backend/tests/control_plane -p \"mysql_integration_test.py\""
