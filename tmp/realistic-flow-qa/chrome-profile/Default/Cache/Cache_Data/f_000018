      ? `已确认 ${success} 条低风险设定变更，跳过 ${skipped} 条冲突风险项，请逐条确认`
      : `已确认 ${success} 条设定变更`)
  } catch (e) {
    message.error(`批量确认中断：已确认 ${success} 条，失败原因：${e.message}`)
  } finally {
    batchAcceptingChanges.value = false
  }
